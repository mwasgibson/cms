# Base URL of the hotel backend's API. Port must match PORT in the hotel
# backend's own .env (its code falls back to 3000 if PORT isn't set).
VITE_API_URL=http://localhost:3000/api

#
# Rooms, Deals, and Auth ALWAYS use the real API above, regardless of this
# flag — see features/deals/services/dealService.js,
# features/rooms/services/roomService.js, and features/auth/services/authService.js.
VITE_USE_MOCKS=true